PORT=3000
DB_AUTH=windows
DB_SERVER=NHUY
DB_INSTANCE=MSSQLSERVER01
DB_NAME=CineManager
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
SESSION_DAYS=7
# Nếu máy chỉ cài ODBC Driver 17, đổi DB_ODBC_DRIVER cho đúng.
# Muốn dùng cổng cố định: để DB_INSTANCE= và thêm DB_PORT=<cổng thực tế>.
